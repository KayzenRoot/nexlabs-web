{
  "name": "nexlabs-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static-first institutional web foundation for NexLabs Technology.",
  "license": "UNLICENSED",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:tokens && next build && npm run report:bundle",
    "start": "node scripts/serve-static.mjs",
    "preview": "npm run build && wrangler dev --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:e2e": "npm run build && playwright test",
    "build:manifest": "node scripts/build-brand-manifest.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "validate": "npm run validate:tokens && npm run build:manifest && npm run validate:content && npm run validate:links && npm run validate:assets",
    "validate:tokens": "node scripts/validate-tokens.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "report:bundle": "node scripts/report-bundle.mjs",
    "security": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate && npm run build",
    "ci": "npm run check"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true,
    "unrs-resolver@1.12.2": true
  }
}
