{
  "name": "nexlabs-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static-first institutional web foundation for NexLabs Technology.",
  "license": "UNLICENSED",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/run-sequence.mjs build:tokens build:next report:bundle",
    "build:next": "next build",
    "start": "node scripts/serve-static.mjs",
    "preview": "node scripts/run-sequence.mjs build preview:serve",
    "preview:serve": "wrangler dev --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:e2e": "node scripts/run-sequence.mjs build test:e2e:playwright",
    "test:e2e:playwright": "playwright test",
    "build:manifest": "node scripts/build-brand-manifest.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "validate": "node scripts/run-sequence.mjs validate:tokens build:manifest validate:content validate:links validate:assets",
    "validate:tokens": "node scripts/validate-tokens.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:cp07": "python scripts/cp07/validate_runtime.py",
    "validate:governance": "python scripts/validate_governance.py",
    "hive:prepare": "python scripts/hive_prepare.py",
    "validate:release": "node scripts/validate-release.mjs",
    "report:bundle": "node scripts/report-bundle.mjs",
    "security": "node scripts/security-audit.mjs",
    "check": "node scripts/run-sequence.mjs typecheck lint test validate validate:cp07 validate:governance build",
    "ci": "npm run check"
  },
  "dependencies": {
    "@react-three/fiber": "9.3.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.181.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.181.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true,
    "unrs-resolver@1.12.2": true
  }
}
